{
  "name": "weldcom-ai-operations-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "vite --mode api --host 127.0.0.1 --port 5173",
    "dev:mock": "vite --mode mock --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:api": "tsc && vite build --mode api",
    "build:mock": "tsc && vite build --mode mock",
    "demo:api": "npm run build:api && vite preview --mode api --outDir dist-api --host 127.0.0.1 --port 4173",
    "demo:mock": "npm run build:mock && vite preview --mode mock --outDir dist-mock --host 127.0.0.1 --port 4174",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "vitest": "latest",
    "@types/node": "latest"
  }
}
